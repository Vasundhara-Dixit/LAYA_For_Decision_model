import ast, hashlib, json, random, re, string
from collections import Counter, defaultdict
from pathlib import Path

SEED = 42
OUT = Path('/kaggle/working/data'); OUT.mkdir(parents=True, exist_ok=True)
PER_DOC_CAP = 3                      # max candidates per class per document -> more document diversity
TRAIN_EACH, VAL_EACH, TEST_EACH = 1500, 300, 400   # items PER CLASS in each balanced split
VALUES_PER_TEMPLATE = {'train': 60, 'val': 25, 'test': 25}

# ---- 1. LABEL POLICY ------------------------------------------------------
# Old POLICY was an exact-match set, so 'telephonenum', 'idcardnum', 'passportnum',
# 'taxnum' (ai4privacy) and 'user_name' (Nemotron) were silently DROPPED.
# Now: keyword match for sensitive labels + an explicit per-source "not sensitive" list.
POS_KW = re.compile(
    r'(first_?name|last_?name|full_?name|given|surname|^name$|e_?mail|phone|tel(ephone)?|mobile|street|address|'
    r'birth|dob|ssn|social|passport|tax|id_?card|driver|licen[sc]e|account|card_?num|credit|debit|iban|routing|'
    r'password|user_?name|api_?key|secret|token|ip_?addr|medical|health|biometric|customer_id|employee_id|'
    r'aadhaar|upi|^pan$)')
NEG_LABELS = {   # annotated by the dataset as a real entity, but NOT private under our policy. EDIT if you disagree.
    'nemotron':   {'company_name', 'occupation', 'country', 'state', 'city', 'time', 'date', 'language'},
    'ai4privacy': {'city', 'time'},          # ai4privacy 'date' can be a birth date -> left out on purpose
}
def norm_label(x): return re.sub(r'[^a-z0-9]+', '_', str(x).lower()).strip('_')
def label_class(source, label):
    if label in NEG_LABELS.get(source, ()): return 'neg'
    if POS_KW.search(label): return 'pos'
    return 'drop'

def make_record(context, candidate, sensitive, source, group, kind=''):
    if not (isinstance(context, str) and isinstance(candidate, str) and context.strip() and candidate.strip()):
        return None
    return {'state': {'body': f'Context: {context}\nCandidate: {candidate}'},
            'questions': {'is_sensitive': {'type': 'noul',
                          'instructions': 'Is the candidate private or sensitive information in this context?'}},
            'expected': {'is_sensitive': bool(sensitive)}, 'source': source, 'group': str(group), 'kind': kind}

def spans_list(obj):
    if isinstance(obj, str):
        try: obj = json.loads(obj)
        except (ValueError, TypeError): obj = ast.literal_eval(obj)
    if obj is None: return []
    if not isinstance(obj, list): raise ValueError('non-list annotation')
    return obj

# ---- 2. DATASET-SPECIFIC CONVERTERS (positives AND negatives from the same real documents) ----
def convert_spans(rows, source, text_key, span_key, rng):
    pos, neg, inventory, stats = [], [], Counter(), Counter()
    for row in rows:
        text = row.get(text_key)
        if not isinstance(text, str) or not text.strip(): stats['bad_text'] += 1; continue
        try: spans = spans_list(row.get(span_key))
        except (ValueError, TypeError, SyntaxError): stats['bad_spans'] += 1; continue
        group = hashlib.sha256(text.encode('utf-8')).hexdigest()
        dp, dn = [], []
        for sp in spans:
            if not isinstance(sp, dict): continue
            lab = norm_label(sp.get('label', '')); cls = label_class(source, lab); inventory[(lab, cls)] += 1
            if cls == 'drop': continue
            a, b = sp.get('start'), sp.get('end')
            if not (isinstance(a, int) and isinstance(b, int) and 0 <= a < b <= len(text)): stats['bad_offset'] += 1; continue
            cand = text[a:b]; supplied = sp.get('text', sp.get('value'))
            if isinstance(supplied, str) and supplied != cand: stats['text_mismatch'] += 1; continue
            rec = make_record(text[max(0, a - 160):min(len(text), b + 160)], cand, cls == 'pos', source, group, lab)
            if rec: (dp if cls == 'pos' else dn).append(rec)
        pos += rng.sample(dp, min(PER_DOC_CAP, len(dp))); neg += rng.sample(dn, min(PER_DOC_CAP, len(dn)))
    print(f'\n[{source}] positives={len(pos)} negatives={len(neg)} stats={dict(stats)}')
    print('   label inventory  (label, decision) -> count   [pos=sensitive, neg=not sensitive, drop=ignored]')
    for (lab, cls), n in sorted(inventory.items(), key=lambda kv: (kv[0][1], -kv[1])): print(f'   {lab:32s} {cls:5s} {n}')
    return pos, neg

def convert_bio(rows, rng):          # Naamapadam: PER -> sensitive, LOC/ORG -> not sensitive (real Hindi sentences)
    pos, neg = [], []
    for idx, row in enumerate(rows):
        toks, tags = row.get('tokens', []), row.get('ner_tags', [])
        if not toks or len(toks) != len(tags) or not all(isinstance(t, str) for t in toks): continue
        ctx, dp, dn, i = ' '.join(toks), [], [], 0
        while i < len(toks):
            tag = str(tags[i])
            if tag.startswith('B-'):
                typ, j = tag[2:], i + 1
                while j < len(tags) and str(tags[j]) == 'I-' + typ: j += 1
                rec = make_record(ctx, ' '.join(toks[i:j]), typ == 'PER', 'naamapadam', f'naamapadam_{idx}', typ)
                if rec and typ == 'PER': dp.append(rec)
                elif rec and typ in ('LOC', 'ORG'): dn.append(rec)
                i = j
            else: i += 1
        pos += rng.sample(dp, min(2, len(dp))); neg += rng.sample(dn, min(2, len(dn)))
    print(f'\n[naamapadam] PER positives={len(pos)}  LOC/ORG negatives={len(neg)}')
    return pos, neg

# ---- 3. MINIMAL PAIRS: same value SHAPE, opposite meaning, templates disjoint across splits ----
def gen_value(shape, r):
    D = string.digits
    if shape == 'id12':
        s = r.choice('23456789') + ''.join(r.choice(D) for _ in range(11)); return r.choice([s, f'{s[:4]} {s[4:8]} {s[8:]}'])
    if shape == 'alnum10':
        return ''.join(r.choice(string.ascii_uppercase) for _ in range(5)) + ''.join(r.choice(D) for _ in range(4)) + r.choice(string.ascii_uppercase)
    if shape == 'phone10': return r.choice('6789') + ''.join(r.choice(D) for _ in range(9))
    return ''.join(r.choice(D) for _ in range(r.randint(11, 16)))        # 'acct'
# template order: [en, en, hindi, en(val), hinglish, en(test)]  -> split by position
TEMPLATE_SPLIT = ['train', 'train', 'train', 'val', 'train', 'test']
SENS = {
 'id12':    ['My Aadhaar number is {v}', 'Aadhaar: {v}', 'मेरा आधार नंबर {v} है', 'Please link Aadhaar {v} to my mobile for KYC.', 'Mera Aadhaar number {v} hai, please update it.', 'Applicant UID (Aadhaar) {v} verified.'],
 'alnum10': ['My PAN is {v}', 'PAN card number: {v}', 'मेरा पैन कार्ड नंबर {v} है', 'Please update PAN {v} in my tax profile.', 'Mera PAN {v} hai, form 16 bhej do.', 'Income tax PAN of the applicant: {v}'],
 'phone10': ['My mobile number is {v}', 'Call me on {v} after 6 pm.', 'मेरा मोबाइल नंबर {v} है', 'WhatsApp me at {v}', 'Mera number {v} hai, call kar lena.', 'Personal contact number: {v}'],
 'acct':    ['My bank account number is {v}', 'Please credit the amount to account {v}.', 'मेरा बैंक खाता नंबर {v} है', 'Salary account no. {v}', 'Mera account number {v} hai, paise bhej do.', 'A/C No: {v} (savings)'],
}
NEUT = {
 'id12':    ['Order ID is {v}', 'Your tracking number is {v}.', 'ऑर्डर नंबर {v} है', 'Invoice number: {v}', 'Order number {v} hai, status check karo.', 'Product serial number {v} registered.'],
 'alnum10': ['The product SKU is {v}', 'Part code: {v}', 'प्रोडक्ट कोड {v} है', 'Use promo code {v} at checkout.', 'Product code {v} hai, stock check karo.', 'Batch label printed on the box: {v}'],
 'phone10': ['The barcode on the package is {v}', 'Reference code: {v}', 'बारकोड नंबर {v} है', 'The file size is {v} bytes.', 'Barcode {v} hai, scan karo.', 'Catalog number {v} listed on page 4.'],
 'acct':    ['Transaction reference {v} completed.', 'The shipment container ID is {v}.', 'पार्सल आईडी {v} है', 'Ticket number {v} is open.', 'Tracking id {v} hai, check karo.', 'Serial no. {v} (warranty).'],
}
def build_pairs(rng):
    out = {'train': [], 'val': [], 'test': []}
    for shape in SENS:
        for label, table in ((True, SENS), (False, NEUT)):
            for ti, tmpl in enumerate(table[shape]):
                split = TEMPLATE_SPLIT[ti]
                for k in range(VALUES_PER_TEMPLATE[split]):
                    v = gen_value(shape, rng)
                    rec = make_record(tmpl.format(v=v), v, label, 'pairs', f'pair|{shape}|{label}|{ti}|{k}', shape)
                    if rec: out[split].append(rec)
    return out

