# Official Hindi Naamapadam archive
url = (
    "https://huggingface.co/datasets/"
    "ai4bharat/naamapadam/resolve/main/"
    "data/hi_IndicNER_v1.0.zip"
)

folder = Path("/kaggle/working/naamapadam")
folder.mkdir(parents=True, exist_ok=True)

zip_path = folder / "hindi.zip"

# Download
if not zip_path.exists():
    response = requests.get(url, stream=True, timeout=120)
    response.raise_for_status()

    with open(zip_path, "wb") as f:
        for chunk in response.iter_content(chunk_size=1024 * 1024):
            f.write(chunk)

print("Download complete")

# Extract
with zipfile.ZipFile(zip_path) as z:
    names = z.namelist()

    # Expected file from official loading script
    train_file = next(
        (n for n in names if n.endswith("hi_train.json")),
        None
    )

    if train_file is None:
        raise FileNotFoundError(
            f"Training file not found. Archive contents: {names}"
        )

    # Read first 2000 JSON-lines records without
    # extracting the entire archive
    indic_sample = []

    with z.open(train_file) as f:
        for line in f:
            if len(indic_sample) >= 2000:
                break

            item = json.loads(line.decode("utf-8"))

            indic_sample.append({
                "tokens": item["words"],
                "ner_tags": item["ner"]
            })

