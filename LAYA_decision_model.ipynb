# ---- 5. BUILD EVERYTHING ----
rng = random.Random(SEED)
nem_pos, nem_neg = convert_spans(nemotron_sample, 'nemotron', 'text', 'spans', rng)
ai_pos, ai_neg = convert_spans(multilingual_sample, 'ai4privacy', 'source_text', 'privacy_mask', rng)
hi_pos, hi_neg = convert_bio(indic_sample, rng)
pairs = build_pairs(rng)
ood_rows = [make_record(c, x, y, 'ood', f'ood_{i}', 'handwritten') for i, (c, x, y) in enumerate(OOD)]

def bucket(r):   # stable 80/10/10 split by SOURCE DOCUMENT (positives and negatives of one document stay together)
    h = int(hashlib.sha256((r['source'] + '|' + r['group']).encode()).hexdigest()[:12], 16) % 100
    return 'train' if h < 80 else 'val' if h < 90 else 'test'
pools = {'train': [], 'val': [], 'test': []}
seen, conflicts = {}, set()
for r in nem_pos + nem_neg + ai_pos + ai_neg + hi_pos + hi_neg:
    key = r['state']['body']
    if key in seen and seen[key]['expected']['is_sensitive'] != r['expected']['is_sensitive']: conflicts.add(key)
    elif key not in seen: seen[key] = r
for k in conflicts: seen.pop(k, None)
for r in seen.values(): pools[bucket(r)].append(r)
for split in pools: pools[split] += pairs[split]
print('\nconflicting duplicate bodies removed:', len(conflicts))

QUOTA = {True:  {'nemotron': .35, 'ai4privacy': .25, 'naamapadam': .12, 'pairs': .28},
         False: {'nemotron': .30, 'ai4privacy': .25, 'naamapadam': .17, 'pairs': .28}}
def draw(pool, label, total, seed):
    rnd = random.Random(seed); chosen = []
    for src, share in QUOTA[label].items():
        items = [r for r in pool if r['expected']['is_sensitive'] == label and r['source'] == src]
        rnd.shuffle(items); chosen += items[:int(total * share)]
    if len(chosen) < total:                                            # top up from whatever is left
        ids = {id(x) for x in chosen}
        rest = [r for r in pool if r['expected']['is_sensitive'] == label and id(r) not in ids]
        rnd.shuffle(rest); chosen += rest[:total - len(chosen)]
    return chosen
def balanced(pool, each, seed):
    p, n = draw(pool, True, each, seed), draw(pool, False, each, seed + 1)
    m = min(len(p), len(n)); sel = p[:m] + n[:m]; random.Random(seed).shuffle(sel); return sel

splits = {'train': balanced(pools['train'], TRAIN_EACH, 1), 'val': balanced(pools['val'], VAL_EACH, 2),
          'test': balanced(pools['test'], TEST_EACH, 3), 'test_natural': pools['test'], 'ood': ood_rows}
for name, rows in splits.items():
    with (OUT / f'{name}.jsonl').open('w', encoding='utf-8') as f, (OUT / f'{name}_meta.jsonl').open('w', encoding='utf-8') as g:
        for r in rows:
            f.write(json.dumps({k: r[k] for k in ('state', 'questions', 'expected')}, ensure_ascii=False) + '\n')
            g.write(json.dumps({'source': r['source'], 'group': r['group'], 'kind': r['kind']}, ensure_ascii=False) + '\n')

# ---- 6. REPORT + LEAKAGE CHECKS ----
print('\n=== composition (source x label) ===')
for name in ('train', 'val', 'test', 'test_natural', 'ood'):
    c = Counter((r['source'], r['expected']['is_sensitive']) for r in splits[name])
    tot = Counter(r['expected']['is_sensitive'] for r in splits[name])
    print(f'{name:13s} total={len(splits[name]):5d}  sensitive={tot[True]:5d}  not_sensitive={tot[False]:5d}')
    for (src, lab), n in sorted(c.items()): print(f'      {src:12s} {"sensitive" if lab else "not_sens":10s} {n}')
bodies = {n: {r['state']['body'] for r in splits[n]} for n in ('train', 'val', 'test', 'ood')}
for a, b in (('train', 'val'), ('train', 'test'), ('val', 'test'), ('train', 'ood')):
    assert not (bodies[a] & bodies[b]), f'identical examples shared between {a} and {b}'
docs = {n: {(r['source'], r['group']) for r in splits[n] if r['source'] != 'pairs'} for n in ('train', 'val', 'test')}
assert not (docs['train'] & docs['val'] or docs['train'] & docs['test'] or docs['val'] & docs['test']), 'document leakage'
print('\nOK: no shared examples, no shared documents, minimal-pair templates are disjoint across train/val/test.')





