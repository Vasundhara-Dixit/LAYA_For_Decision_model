ax[1].set(title='Loss per epoch', xlabel='epoch (0 = before fine-tuning)', ylabel='cross-entropy'); ax[1].grid(alpha=.3); ax[1].legend(loc='upper right')
ol = nanify(H['opt_loss'])
if np.isfinite(ol).any():
    t = ax[1].twinx(); t.plot(ep, ol, 'k--', alpha=.45, label='optimizer mean loss (right axis)'); t.set_ylabel('optimizer loss'); t.legend(loc='center right')
mark_best(ax[1])

# 3) sensitive-class quality (what matters for a leak-prevention gateway)
for k, lab, m in (('val_precision', 'precision', 'o-'), ('val_recall', 'recall', 's-'), ('val_f1', 'F1', '^-')): ax[2].plot(ep, H[k], m, label=f'val {lab}')
ax[2].set(title='Sensitive class on validation', xlabel='epoch (0 = before fine-tuning)', ylim=(0, 1.02)); ax[2].grid(alpha=.3); ax[2].legend(loc='lower right'); mark_best(ax[2])

fig.suptitle(f'Laya fine-tuning  |  top layers={meta["top_layers"]}  loss={meta["loss"]}  label smoothing={meta["label_smoothing"]}  |  {meta["minutes"]} min', y=1.02)
plt.tight_layout(); fig.savefig(FIG / 'training_curves.png', dpi=160, bbox_inches='tight'); plt.show()

# automatic reading of the curves - judged at the epoch that was KEPT (best), plus what happened after it
ib = list(ep).index(best) if best in list(ep) else len(ep) - 1
tr_a, va_a, gap = H['train_acc'][ib], H['val_acc'][ib], H['train_acc'][ib] - H['val_acc'][ib]
worse_after = (H['val_ce'][-1] - H['val_ce'][ib]) if ib < len(ep) - 1 else 0.0
print(f'kept epoch {best}: train acc {tr_a:.3f} | val acc {va_a:.3f} | gap {gap:+.3f} | val CE {H["val_ce"][ib]:.3f}')
if ib < len(ep) - 1: print(f'epochs after the kept one: validation CE changed by {worse_after:+.3f} (last epoch vs kept epoch)')
if tr_a < 0.90 and va_a < 0.90:
    print('READING: UNDERFITTING - train AND validation are both low. Raise TOP_LAYERS (6 -> -1), add epochs, raise encoder_lr, check label noise.')
elif gap > 0.05:
    print('READING: OVERFITTING - train is clearly above validation. Fewer TOP_LAYERS/epochs, more label smoothing, more diverse data.')
elif worse_after > 0.05:
    print('READING: MILD OVERFITTING AFTER the kept epoch - validation got worse while training continued; best-epoch restore already protects you.')
else:
    print('READING: curves look healthy (small gap, no rising validation loss). Confirm on the held-out TEST and OOD sets in cell D2 first.')





# ============================================================================
# CELL D2 - CONFUSION MATRIX + FULL FINAL EVALUATION  (run after Cell C; GPU optional)
# Sets: val (only used to pick the threshold) | test (balanced, held out) | test_natural (real class ratio)
#       | ood (hand-written, never trained, includes same-candidate/different-context pairs)
# ============================================================================
import json
from pathlib import Path
import numpy as np, pandas as pd
import matplotlib.pyplot as plt
from sklearn.metrics import (confusion_matrix, roc_auc_score, average_precision_score, roc_curve,
                             precision_recall_curve, matthews_corrcoef, balanced_accuracy_score, fbeta_score)
import laya
try:
    import torch; DEVICE = 'cuda' if torch.cuda.is_available() else 'cpu'
except ImportError: DEVICE = 'cpu'

OUT_DIR = '/kaggle/working/laya-pii-v3'; D = Path('/kaggle/working/data')
FIG = Path('/kaggle/working/figures'); FIG.mkdir(exist_ok=True)
QUESTIONS = {'is_sensitive': {'type': 'noul', 'instructions': 'Is the candidate private or sensitive information in this context?'}}   # must equal the training text
NAMES = ['Not sensitive', 'Sensitive']

agent = laya.load(OUT_DIR, device=DEVICE)
def predict_p(rows, bs=32):
    """P(sensitive) for each row (calibrated by the temperature saved with the checkpoint)."""
    ps = []
    for i in range(0, len(rows), bs):
        chunk = rows[i:i + bs]
        for o in agent.predict_batch([r['state'] for r in chunk], QUESTIONS, batch_size=bs):
            ps.append(float((o.get('answers', o))['is_sensitive']['noul']))
    return np.array(ps)

def read(name):
    rows = [json.loads(l) for l in (D / f'{name}.jsonl').open(encoding='utf-8') if l.strip()]
    mp = D / f'{name}_meta.jsonl'
    meta = [json.loads(l) for l in mp.open(encoding='utf-8') if l.strip()] if mp.exists() else [{}] * len(rows)
    return rows, meta, np.array([int(r['expected']['is_sensitive']) for r in rows])
S = {}
for name in ('val', 'test', 'test_natural', 'ood'):
    if (D / f'{name}.jsonl').exists():
        rows, meta, y = read(name); S[name] = dict(rows=rows, meta=meta, y=y, p=predict_p(rows)); print(f'predicted {name}: {len(rows)} items')

# ---- operating point: chosen on VALIDATION only. Recall-weighted (a missed secret costs more than a false alarm),
#      but never allowed to "flag everything": the false-positive rate must stay <= MAX_FPR ----
MAX_FPR = 0.10
grid = np.round(np.arange(0.05, 0.96, 0.01), 2)
yv_, pv_ = S['val']['y'], S['val']['p']
f2 = np.array([fbeta_score(yv_, (pv_ >= t).astype(int), beta=2, zero_division=0) for t in grid])
fpr_v = np.array([((pv_ >= t) & (yv_ == 0)).sum() / max((yv_ == 0).sum(), 1) for t in grid])
allowed = fpr_v <= MAX_FPR
if allowed.any(): THR = float(grid[np.where(allowed)[0][int(np.argmax(f2[allowed]))]])
else: THR = 0.5; print(f'WARNING: no threshold keeps validation FPR <= {MAX_FPR}; falling back to 0.50 - the model is not separating the classes well.')
print(f'\nthreshold chosen on validation (max F2 with FPR <= {MAX_FPR:.0%}): {THR:.2f}   (default 0.50)')

def metrics(y, p, thr):
    pred = (p >= thr).astype(int); tn, fp, fn, tp = confusion_matrix(y, pred, labels=[0, 1]).ravel()
    both = len(set(y)) == 2; div = lambda a, b: a / b if b else float('nan')
    pr, rc = div(tp, tp + fp), div(tp, tp + fn)
    return {'n': len(y), 'accuracy': (tp + tn) / len(y), 'balanced_acc': balanced_accuracy_score(y, pred) if both else float('nan'),
            'precision': pr, 'recall(sens)': rc, 'specificity': div(tn, tn + fp), 'F1': div(2 * pr * rc, pr + rc), 'FPR': div(fp, fp + tn), 'FNR': div(fn, fn + tp),
            'MCC': matthews_corrcoef(y, pred) if both and len(set(pred)) == 2 else float('nan'),
            'ROC_AUC': roc_auc_score(y, p) if both else float('nan'), 'PR_AUC': average_precision_score(y, p) if both else float('nan'),
            'TN': int(tn), 'FP': int(fp), 'FN': int(fn), 'TP': int(tp)}

rows_out = []
for name, d in S.items():
    for thr in ([0.5] if THR == 0.5 else [0.5, THR]):
        rows_out.append({'set': name, 'thr': f'@{thr:.2f}', **metrics(d['y'], d['p'], thr)})
R = pd.DataFrame(rows_out)
pd.set_option('display.width', 250); pd.set_option('display.max_columns', 30)
print('\n=== FINAL METRICS ===\n' + R.round(3).to_string(index=False))
R.to_csv('/kaggle/working/final_metrics.csv', index=False)

# ---- FIGURE 1: confusion matrices ----
def cm_plot(ax, y, p, thr, title):
    cm = confusion_matrix(y, (p >= thr).astype(int), labels=[0, 1]); pct = cm / np.maximum(cm.sum(1, keepdims=True), 1)
    ax.imshow(pct, cmap='Blues', vmin=0, vmax=1)
    for i in range(2):
        for j in range(2): ax.text(j, i, f'{cm[i, j]}\n({pct[i, j]:.1%})', ha='center', va='center', fontsize=12, color='white' if pct[i, j] > .5 else 'black')
    ax.set(xticks=[0, 1], yticks=[0, 1], xticklabels=NAMES, yticklabels=NAMES, xlabel='Predicted', ylabel='Actual', title=title)
sets_ = [n for n in ('test', 'test_natural', 'ood') if n in S]; thrs_ = [0.5] if THR == 0.5 else [0.5, THR]
fig, ax = plt.subplots(len(thrs_), len(sets_), figsize=(4.6 * len(sets_), 4.5 * len(thrs_)), squeeze=False)
for r_, t in enumerate(thrs_):
    for c_, n in enumerate(sets_): cm_plot(ax[r_, c_], S[n]['y'], S[n]['p'], t, f'{n}  (n={len(S[n]["y"])})  threshold {t:.2f}')
plt.tight_layout(); fig.savefig(FIG / 'confusion_matrices.png', dpi=160, bbox_inches='tight'); plt.show()

# ---- FIGURE 2: ROC, PR, probability histogram, reliability ----
fig, ax = plt.subplots(2, 2, figsize=(12, 9))
for n in ('test', 'test_natural', 'ood'):
    if n in S and len(set(S[n]['y'])) == 2:
        fpr, tpr, _ = roc_curve(S[n]['y'], S[n]['p']); ax[0, 0].plot(fpr, tpr, label=f'{n} (AUC {roc_auc_score(S[n]["y"], S[n]["p"]):.3f})')
        pr, rc, _ = precision_recall_curve(S[n]['y'], S[n]['p']); ax[0, 1].plot(rc, pr, label=f'{n} (AP {average_precision_score(S[n]["y"], S[n]["p"]):.3f})')
ax[0, 0].plot([0, 1], [0, 1], 'k:', lw=1); ax[0, 0].set(title='ROC curve', xlabel='false positive rate', ylabel='true positive rate'); ax[0, 0].legend(loc='lower right')
ax[0, 1].set(title='Precision-recall curve (sensitive class)', xlabel='recall', ylabel='precision', ylim=(0, 1.02)); ax[0, 1].legend(loc='lower left')
t = S['test']; bins = np.linspace(0, 1, 21)
ax[1, 0].hist(t['p'][t['y'] == 0], bins, alpha=.65, label='actually NOT sensitive'); ax[1, 0].hist(t['p'][t['y'] == 1], bins, alpha=.65, label='actually sensitive')
ax[1, 0].axvline(THR, color='k', ls='--', lw=1); ax[1, 0].set(title='Predicted probability on TEST (two clean humps = confident; middle mass = confusion)', xlabel='P(sensitive)', ylabel='count'); ax[1, 0].legend()
edges = np.linspace(0, 1, 11); idx = np.clip(np.digitize(t['p'], edges) - 1, 0, 9)
xs = [t['p'][idx == b].mean() for b in range(10) if (idx == b).sum() >= 5]; ys = [t['y'][idx == b].mean() for b in range(10) if (idx == b).sum() >= 5]
ax[1, 1].plot([0, 1], [0, 1], 'k:', label='perfect calibration'); ax[1, 1].plot(xs, ys, 'o-', label='model')
ax[1, 1].set(title='Reliability diagram (TEST)', xlabel='mean predicted P(sensitive)', ylabel='observed fraction sensitive'); ax[1, 1].legend()
plt.tight_layout(); fig.savefig(FIG / 'roc_pr_calibration.png', dpi=160, bbox_inches='tight'); plt.show()

# ---- FIGURE 3: per-source quality (is it good everywhere or only on the easy source?) ----
def per_source(name):
    d = S[name]; df = pd.DataFrame({'source': [m.get('source', '?') for m in d['meta']], 'y': d['y'], 'pred': (d['p'] >= THR).astype(int)})
    out = []
    for s, g in df.groupby('source'):
        pos, neg = g[g.y == 1], g[g.y == 0]
        out.append({'source': s, 'n_sens': len(pos), 'recall(sens)': (pos.pred == 1).mean() if len(pos) else np.nan, 'n_not': len(neg), 'specificity': (neg.pred == 0).mean() if len(neg) else np.nan})
    return pd.DataFrame(out)
PS = per_source('test'); print(f'\n=== PER-SOURCE on TEST (threshold {THR:.2f}) ===\n' + PS.round(3).to_string(index=False))
fig, a = plt.subplots(figsize=(9, 4.2)); x = np.arange(len(PS)); w = .38
a.bar(x - w / 2, PS['recall(sens)'], w, label='recall on sensitive items'); a.bar(x + w / 2, PS['specificity'], w, label='specificity on non-sensitive items')
a.set(xticks=x, xticklabels=PS.source, ylim=(0, 1.05), title='TEST quality by data source'); a.legend(loc='lower right'); a.grid(axis='y', alpha=.3)
plt.tight_layout(); fig.savefig(FIG / 'per_source.png', dpi=160, bbox_inches='tight'); plt.show()

# ---- FIGURE 4: threshold sweep (validation) ----
pv, yv = S['val']['p'], S['val']['y']; sw = []
for th in grid:
    m = metrics(yv, pv, th); sw.append((m['precision'], m['recall(sens)'], m['F1']))
sw = np.array(sw, dtype=float); fig, a = plt.subplots(figsize=(8, 4.2))
for k, lab in enumerate(('precision', 'recall', 'F1')): a.plot(grid, sw[:, k], label=lab)
a.plot(grid, f2, label='F2 (recall-weighted)'); a.axvline(THR, color='k', ls='--', lw=1); a.set(title='Threshold sweep on VALIDATION', xlabel='threshold', ylim=(0, 1.02)); a.legend(); a.grid(alpha=.3)
plt.tight_layout(); fig.savefig(FIG / 'threshold_sweep.png', dpi=160, bbox_inches='tight'); plt.show()

# ---- CONTEXT TEST: same candidate string, different context, must flip ----
if 'ood' in S:
    d = S['ood']; cands = [r['state']['body'].split('\nCandidate: ', 1)[1] for r in d['rows']]
    df = pd.DataFrame({'cand': cands, 'y': d['y'], 'p': d['p']}); ok = tot = 0
    for c, g in df.groupby('cand'):
        if set(g.y) == {0, 1}:
            tot += 1; ok += int((g[g.y == 1].p.min() >= THR) and (g[g.y == 0].p.max() < THR))
    print(f'\n=== CONTEXT-FLIP TEST (hand-written) ===\nsame candidate, opposite meaning, both answered correctly: {ok}/{tot}   <- this is the real "sensitive IN CONTEXT" score')

# ---- the mistakes themselves (the fastest way to learn what to fix) ----
def show_errors(name, k=8):
    d = S[name]; pred = (d['p'] >= THR).astype(int); wrong = np.where(pred != d['y'])[0]
    wrong = wrong[np.argsort(-np.abs(d['p'][wrong] - THR))][:k]
    print(f'\n--- most confident mistakes on {name} (of {int((pred != d["y"]).sum())} total) ---')
    for i in wrong:
        b = d['rows'][i]['state']['body'].replace('\n', ' | ')[:150]; src = d['meta'][i].get('source', '?')
        print(f'  actual={NAMES[d["y"][i]]:13s} P(sens)={d["p"][i]:.2f} src={src:11s} {b}')
for n in ('test', 'ood'):
    if n in S: show_errors(n)
