# ============================================================================
# CELL C - TRAIN LAYA WITH PER-EPOCH TRACKING  (replaces old cells 17, 18, 21, 24)
# - logs train/val accuracy, loss, precision, recall, F1 after EVERY epoch (and before epoch 1)
# - keeps the weights of the best epoch (early-stopping effect) and saves them
# - same trainer as before: repo's finetune.freeze_bottom + laya.train.finetune
# ============================================================================
import json, random, subprocess, sys, time
from pathlib import Path
import numpy as np

# ---------------- knobs (the only things you normally touch) ----------------
TOP_LAYERS   = 6            # 2 = light/underfit-prone, 6 = good default, -1 = whole encoder (T4 can fit it with MICRO=4)
EPOCHS       = 5            # best epoch is restored automatically, so a few extra epochs are safe
LOSS         = 'soft-ce'    # plain cross-entropy -> train and val losses are directly comparable ('rlcd' adds an RL term)
LABEL_SMOOTH = 0.05         # 0.0 = off; stops the model from pushing probabilities to exactly 0/1 (helps overfitting)
MICRO, ACCUM, SEED = 4, 8, 0
SELECT_BY    = 'val_f1'     # 'val_f1' (sensitive-class F1) or 'val_ce' (lowest validation cross-entropy)
TRAIN_SUBSET = 400          # train items re-scored in eval mode each epoch (a fair train-vs-val comparison)

DATA = Path('/kaggle/working/data'); OUT_DIR = '/kaggle/working/laya-pii-v3'
HIST_PATH = Path('/kaggle/working/history.json')
REPO = Path('/kaggle/working/laya-fine-tuning')
if not (REPO / 'finetune.py').exists():
    subprocess.run(['git', 'clone', '-q', 'https://github.com/bnap00/laya-fine-tuning.git', str(REPO)], check=True)
sys.path.insert(0, str(REPO))
import importlib
import laya.train as lt
lt = importlib.reload(lt)                  # fresh start: undoes monkey-patches from any earlier run of this cell
import finetune as ft                      # the repo's helper that freezes the bottom layers

HIST = {k: [] for k in ('epoch', 'opt_loss', 'train_acc', 'train_ce', 'train_f1', 'val_acc', 'val_ce', 'val_precision', 'val_recall', 'val_f1')}
BEST = {'score': None, 'epoch': None}

def snapshot(model, tok, items, device, max_len, head_max_len, parallel):
    """accuracy / cross-entropy / sensitive-class precision-recall-F1 on already-encoded items (uncalibrated, eval mode)."""
    recs = lt.calibration_records(model, tok, items, device, max_len, head_max_len, parallel=parallel)   # also calls model.eval()
    ev = lt.evaluate_records(recs)                                                                      # no temperature -> raw logits
    y = np.array([int(np.argmax(t[:k]) == 1) for _, _, t, k in recs])        # option index 1 = "true" for noul questions
    p = np.array([int(np.argmax(l[:k]) == 1) for _, l, _, k in recs])
    tp, fp, fn = int(((y == 1) & (p == 1)).sum()), int(((y == 0) & (p == 1)).sum()), int(((y == 1) & (p == 0)).sum())
    prec, rec = tp / max(tp + fp, 1), tp / max(tp + fn, 1)
    return {'acc': ev['accuracy'], 'ce': ev['loss'], 'precision': prec, 'recall': rec, 'f1': 2 * prec * rec / max(prec + rec, 1e-9)}

_orig_train_model = lt.train_model
def tracked_train_model(model, tok, items, config, device, max_len, head_max_len, on_epoch_end=None, parallel=False):
    rd = dict(text_column=config.text_column, label_column=config.label_column, question_id=config.question_id, instructions=config.instructions)
    val_items, _ = lt.items_from_rows(tok, lt.read_data(str(DATA / 'val.jsonl'), **rd), max_len, head_max_len, label_smoothing=0.0)
    tr_rows = lt.read_data(str(DATA / 'train.jsonl'), **rd); random.Random(0).shuffle(tr_rows)
    tr_items, _ = lt.items_from_rows(tok, tr_rows[:TRAIN_SUBSET], max_len, head_max_len, label_smoothing=0.0)   # un-smoothed targets
    trainable = [n for n, p in model.named_parameters() if p.requires_grad]
    best_state = {}

    def record(epoch, opt_loss):
        was_training = model.training
        tr, va = (snapshot(model, tok, s, device, max_len, head_max_len, parallel) for s in (tr_items, val_items))
        model.train(was_training)                                   # calibration_records left the model in eval mode
        for k, v in (('epoch', epoch + 1), ('opt_loss', opt_loss), ('train_acc', tr['acc']), ('train_ce', tr['ce']), ('train_f1', tr['f1']),
                     ('val_acc', va['acc']), ('val_ce', va['ce']), ('val_precision', va['precision']), ('val_recall', va['recall']), ('val_f1', va['f1'])):
            HIST[k].append(v)
        score = va['f1'] if SELECT_BY == 'val_f1' else -va['ce']
        if epoch >= 0 and (BEST['score'] is None or score > BEST['score']):
            BEST.update(score=score, epoch=epoch + 1)
            sd = dict(model.named_parameters())
            best_state.clear(); best_state.update({n: sd[n].detach().cpu().clone() for n in trainable})
        print(f'  [epoch {epoch + 1}] train acc {tr["acc"]:.3f} ce {tr["ce"]:.3f} | val acc {va["acc"]:.3f} ce {va["ce"]:.3f} '
              f'P {va["precision"]:.3f} R {va["recall"]:.3f} F1 {va["f1"]:.3f}', flush=True)

    def on_end(epoch, loss):
        record(epoch, loss)
        if on_epoch_end: on_epoch_end(epoch, loss)                  # keeps the library's checkpoint_latest behaviour

    record(-1, None)                                                # epoch 0 = base model before any training
    history = _orig_train_model(model, tok, items, config, device, max_len, head_max_len, on_epoch_end=on_end, parallel=parallel)
    if best_state:                                                  # restore the best epoch, then calibration + saving run on it
        sd = dict(model.named_parameters())
        import torch
        with torch.no_grad():
            for n, v in best_state.items(): sd[n].copy_(v.to(sd[n].device))
        print(f'  restored best epoch = {BEST["epoch"]} ({SELECT_BY})', flush=True)
    return history

lt.train_model = tracked_train_model                                # finetune() looks this name up at call time

ft.freeze_bottom(TOP_LAYERS)
cfg = lt.TrainConfig(epochs=EPOCHS, micro_batch=MICRO, grad_accum=ACCUM, loss=LOSS, label_smoothing=LABEL_SMOOTH,
                     eval_data=str(DATA / 'val.jsonl'), seed=SEED)
tc0 = time.time()
report = lt.finetune(str(DATA / 'train.jsonl'), lt.resolve_checkpoint_dir('multilingual'), OUT_DIR, cfg, device='auto')
lt.train_model = _orig_train_model

HIST['meta'] = {'top_layers': TOP_LAYERS, 'epochs': EPOCHS, 'loss': LOSS, 'label_smoothing': LABEL_SMOOTH, 'select_by': SELECT_BY,
                'best_epoch': BEST['epoch'], 'minutes': round((time.time() - tc0) / 60, 1), 'temperature': report.get('temperature')}
HIST_PATH.write_text(json.dumps(HIST, indent=1, default=float))
print(f'\nSaved model -> {OUT_DIR}\nSaved curves data -> {HIST_PATH}\nbest epoch: {BEST["epoch"]} | total {HIST["meta"]["minutes"]} min')





