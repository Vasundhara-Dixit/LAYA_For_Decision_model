import json
from pathlib import Path

def to_laya_record(example):
    return {
        "state": {
            "body": (
                f"Context: {example['context']}\n"
                f"Candidate: {example['candidate']}"
            )
        },
        "questions": {
            "is_sensitive": {
                "type": "noul",
                "instructions": (
                    "Is the candidate private or sensitive "
                    "information in this context?"
                )
            }
        },
        "expected": {
            "is_sensitive": example["sensitive"]
        }
    }

records = [
    to_laya_record(x)
    for x in indian_examples
]

